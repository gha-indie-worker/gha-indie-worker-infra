{
  "name": "@gha-indie-worker/edge-router",
  "private": true,
  "version": "0.1.0",
  "description": "indiebuild.dev edge router — rendered from router.config.json by ores-edge-router",
  "type": "module",
  "scripts": {
    "validate": "node node_modules/@oresoftware/ores-edge-router/scripts/validate-config.mjs router.config.json",
    "render": "node node_modules/@oresoftware/ores-edge-router/scripts/render-wrangler.mjs router.config.json --out wrangler.toml",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@oresoftware/ores-edge-router": "github:ORESoftware/ores-edge-router#22ac502369068ca6f154b9124b0866b2f633e1ca"
  },
  "devDependencies": {
    "wrangler": "4.30.0"
  }
}
