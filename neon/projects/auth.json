{
  "$schema": "../schema/neon-project.schema.json",
  "role": "auth",
  "provider": "neon",
  "orgId": "org-misty-grass-10005930",
  "projectId": "fancy-brook-94928157",
  "region": "us-east-1",
  "plan": "free",
  "status": "provisioned",
  "autoResume": false,
  "consumers": [
    "shared-auth",
    "gha-indie-worker-api-server.rs"
  ],
  "branches": [
    { "name": "main", "protected": true, "default": true, "parent": null, "purpose": "production" },
    { "name": "dev", "protected": false, "default": false, "parent": "main", "purpose": "development" }
  ],
  "roles": [
    { "name": "giw_auth_owner", "access": "owner", "secretRef": null, "branches": ["main", "dev"] },
    { "name": "giw_auth", "access": "readwrite", "secretRef": "gha-indie-worker-database-url-auth", "branches": ["main"] }
  ],
  "databases": [
    { "name": "giw_auth", "owner": "giw_auth_owner", "schemas": ["public"] }
  ],
  "network": {
    "publicConnectionsBlocked": false,
    "vpcConnectionsBlocked": false,
    "privateNetworking": {
      "enabled": false,
      "blockedReason": "Private networking requires the Scale plan; this org is on Free.",
      "endpointIds": null
    },
    "ipAllow": {
      "enabled": false,
      "cidrs": [],
      "primaryBranchOnly": true
    }
  },
  "notes": [
    "Neon Auth is federated by shared-auth; product servers verify the resulting JWT against NEON_AUTH_JWKS_URL rather than connecting here."
  ]
}
