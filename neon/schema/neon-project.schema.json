{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gha-indie-worker/gha-indie-worker-infra/neon/schema/neon-project.schema.json",
  "title": "NeonProjectDesiredState",
  "description": "Desired state for one Neon project in this org. Records identity, branches, roles, databases and the network posture. Contains no credentials: a role names its secret, it never carries one.",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "provider", "orgId", "projectId", "region", "status", "branches", "roles", "databases", "network"],
  "properties": {
    "$schema": { "type": "string" },
    "role": { "enum": ["canonical", "auth", "admin"] },
    "provider": { "const": "neon" },
    "orgId": { "$ref": "#/definitions/identifier" },
    "projectId": { "$ref": "#/definitions/identifier" },
    "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]$" },
    "plan": { "enum": ["free", "launch", "scale", "business", "enterprise"] },
    "status": { "enum": ["provisioned", "paused", "blocked"] },
    "autoResume": {
      "type": "boolean",
      "description": "Neon suspension alone wakes on traffic. A fleet that is meant to be paused must also prove compute is disabled, so this must be false while expectedState is paused."
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "Repositories permitted to hold a connection string for this project."
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/branch" }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/dbRole" }
    },
    "databases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/database" }
    },
    "network": { "$ref": "#/definitions/network" },
    "blockedReason": { "type": "string", "minLength": 1 },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "todo": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "definitions": {
    "identifier": { "type": ["string", "null"], "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$" },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "protected", "default"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "protected": { "type": "boolean" },
        "default": { "type": "boolean" },
        "parent": { "type": ["string", "null"] },
        "purpose": { "type": "string" }
      }
    },
    "dbRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "access", "secretRef"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "access": { "enum": ["owner", "readwrite", "readonly"] },
        "secretRef": {
          "type": ["string", "null"],
          "description": "Secret Manager secret id holding this role's connection string. NEVER the connection string itself. null means the role has no secret yet.",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "branches": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "owner": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "schemas": { "type": "array", "items": { "type": "string" } }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicConnectionsBlocked", "vpcConnectionsBlocked", "privateNetworking", "ipAllow"],
      "properties": {
        "publicConnectionsBlocked": {
          "type": "boolean",
          "description": "Public (internet) Postgres connections are refused."
        },
        "vpcConnectionsBlocked": {
          "type": "boolean",
          "description": "VPC/private-endpoint connections are refused. Both true means the project accepts NO connections at all — for the admin project that is the intended fail-closed state, not an outage."
        },
        "privateNetworking": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "blockedReason": { "type": "string", "minLength": 1 },
            "endpointIds": {
              "type": ["array", "null"],
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^(vpce|ep)-[A-Za-z0-9-]+$" },
              "description": "AWS VPC endpoint ids (vpce-...). Neon compute endpoint ids (ep-...) are NOT VPC endpoint ids; both spellings are allowed here only so a mistake is visible rather than silently reformatted."
            }
          }
        },
        "ipAllow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "cidrs"],
          "properties": {
            "enabled": { "type": "boolean" },
            "cidrs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$" }
            },
            "primaryBranchOnly": { "type": "boolean" }
          }
        }
      }
    }
  }
}
