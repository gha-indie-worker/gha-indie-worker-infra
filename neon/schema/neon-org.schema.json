{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gha-indie-worker/gha-indie-worker-infra/neon/schema/neon-org.schema.json",
  "title": "NeonOrgDesiredState",
  "description": "Org-level Neon desired state: which organisation, which region, which plan, and where each role's project file lives.",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "orgId", "githubOrg", "defaultRegion", "plan", "expectedState", "projects"],
  "properties": {
    "$schema": { "type": "string" },
    "provider": { "const": "neon" },
    "orgId": { "type": "string", "pattern": "^org-[a-z0-9-]+$" },
    "githubOrg": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$" },
    "defaultRegion": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]$" },
    "plan": { "enum": ["free", "launch", "scale", "business", "enterprise"] },
    "expectedState": { "enum": ["paused", "active"] },
    "contract": { "type": "string", "minLength": 1 },
    "projects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "auth", "admin"],
      "properties": {
        "canonical": { "type": "string", "minLength": 1 },
        "auth": { "type": "string", "minLength": 1 },
        "admin": { "type": "string", "minLength": 1 }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
