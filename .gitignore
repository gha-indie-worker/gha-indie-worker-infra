/target
/node_modules
/build
/.dart_tool
/coverage
.DS_Store
.env
.env.*
!.env.example
*.sqlite
Cargo.lock
!tools/indiebuild-pr-ci-check/Cargo.lock
!tools/dev-runtime/Cargo.lock

# Generated/local application material. The one tracked app checkout is a gitlink,
# not vendored source; every other _apps child and all dist output stay local.
/dist/
/_apps/*
!/_apps/gha-monorepo

# ores-compose materialized source/session state and runtime-only tunnel material.
/.ores/
/.runtime/

# Terraform / OpenTofu working state. Provider downloads, plans and state are local.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
plan.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
!*.tfvars.example
tfplan

# Wrangler
.wrangler/
wrangler.rendered.toml

# Local temporary directories and repository-owned worktrees
tmp/
temp/
tmp
temp
tmp/worktrees
temp/worktrees

# TypeSpec/JSON Schema parity witnesses and receipts are reproducible CI evidence, never an authority.
.typespec-json-schema-validator/
